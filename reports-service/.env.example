PORT=4000

# Segredo compartilhado com o Gestor (Hostinger). O Gestor manda esse mesmo
# valor no header "Authorization: Bearer <segredo>". Gere um valor aleatorio
# forte, nao reutilize senhas existentes.
REPORTS_SHARED_SECRET=

# Mesmo banco de producao usado pelo Gestor na Hostinger (JDBC direto, fora
# do Laravel) - ver DB_* no .env do Gestor.
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
