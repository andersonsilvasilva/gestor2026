<jasperReport name="Blank_A4" language="java" printOrder="Horizontal" pageWidth="595" pageHeight="180" whenNoDataType="NoDataSection" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" whenResourceMissingType="Empty" uuid="f4f5e5cc-00fd-41b2-8b9b-0b57b5fc315c">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="217"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="778"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DataAdapter.jrdax"/>
	<parameter name="id_colaborador" class="java.lang.String"/>
	<parameter name="dta_inicio" class="java.lang.String"/>
	<parameter name="dta_fim" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT
 distinct
 	 clients.cpf,
	clients.nome,
	clients.sexo,
	clients.data_nascimento,
	clients.nacionalidade,
	clients.cor,
	clients.cep,
	clients.logradouro,
	clients.endereco,
	clients.numero,
	clients.bairro,
	clients.telefone,
	clients.email,
	procedimento.name AS nome_proc,
	eventos.start,
	procedimento.tipo_relate,
	procedimento.codigo,
	eventos.client_id,
	eventos.user_id,
	eventos.status,
	eventos.procediments_id,
	eventos.id,
	procedimento.id,
	count( procedimento.name) AS quantidade,
	clients.id
FROM procediments procedimento
	INNER JOIN eventos eventos ON 
	 eventos.procediments_id = procedimento.id 
	INNER JOIN clients clients ON 
	 clients.id = eventos.client_id 
WHERE 
	  ( procedimento.tipo_relate = 'bpa') AND ( eventos.user_id = $P{id_colaborador}) 
	 AND ( eventos.start BETWEEN CAST($P{dta_inicio} AS DATE) AND CAST($P{dta_fim} AS DATE)) 
GROUP BY eventos.client_id,
	procedimento.codigo
ORDER BY clients.nome DESC]]></query>
