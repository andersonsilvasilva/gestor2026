	<style name="Label" mode="Opaque" backcolor="#CCFFFF"/>
	<parameter name="id_colaborador" class="java.lang.String"/>
	<parameter name="dta_inicio" class="java.lang.String"/>
	<parameter name="dta_fim" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT 
				eventos.id,
				eventos.procediments_id, 
				proc.codigo,
				proc.codigo,
				proc.name, 
				eventos.user_id, 
				col.name AS  col, 
				col_det.cpf AS cpf_col,
				col_det.cbo AS cbo_col,
				eventos.client_id, 
				cli.cns AS cns_pac, 
				cli.nome AS nome_pac, 
				eventos.start AS Inicio,	  
				cli.sexo AS sexo_pac,
				cli.data_nascimento AS data_nasc_pac,
				cli.nacionalidade AS nacionalidade_pac,
				cli.cor AS cor_pac,
				cli.cep AS cep_pac,
				 cli.logradouro AS logradouro_pac,
				 cli.endereco AS endereco_pac,
				 cli.numero AS numero_pac,
				 cli.bairro AS bairro_pac,
				 cli.telefone AS fone_pac,
				 cli.email AS email_pac,
				  eventos.status,
				  eventos.deleted_at,
				  eventos.created_at,
				  eventos.updated_at,
				  proc.tipo_relate  FROM eventos
				INNER JOIN user_details  col_det ON  col_det.user_id=eventos.user_id
 				INNER JOIN procediments  proc  ON  proc.id=eventos.procediments_id
 				INNER JOIN clients cli ON cli.id=eventos.client_id
				 INNER JOIN users col ON col.id=eventos.user_id
				 WHERE (proc.tipo_relate='bpa') AND (eventos.user_id= $P{id_colaborador} )  AND
				   (eventos.start  BETWEEN  CAST($P{dta_inicio} AS DATE) AND  CAST($P{dta_fim} AS DATE) )
				   AND eventos.deleted_at IS NULL
				 GROUP BY eventos.user_id]]></query>
