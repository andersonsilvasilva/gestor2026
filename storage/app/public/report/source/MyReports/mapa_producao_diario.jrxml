	<parameter name="id_colaborador" class="java.lang.Integer"/>
	<parameter name="dta_inicio" class="java.lang.String"/>
	<parameter name="dta_fim" class="java.lang.String"/>
	<parameter name="LOGO_PATH" class="java.lang.String"/>
	<parameter name="NOME_INSTITUICAO" class="java.lang.String"/>
	<parameter name="NOME_SECRETARIA" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT	
    DATE(eventos.start) AS dia_mes,
    procedimento.tipo_relate,
    procedimento.codigo,
    procedimento.name AS nome_proc,
    eventos.user_id,
    colaborador.name AS nome_colaborador,
    eventos.status,
    eventos.procediments_id,
    eventos.id AS id_evento,
    procedimento.id AS id_procedimento,
    COUNT(*) AS quant_realizada
FROM eventos AS eventos
INNER JOIN procediments AS procedimento 
        ON eventos.procediments_id = procedimento.id 
INNER JOIN users AS colaborador 
        ON eventos.user_id = colaborador.id
WHERE 
      eventos.user_id = $P{id_colaborador}
  AND eventos.start BETWEEN CAST($P{dta_inicio} AS DATE) AND CAST($P{dta_fim} AS DATE)
GROUP BY 
    dia_mes,
    nome_proc
ORDER BY  
    dia_mes ASC,
    nome_proc ASC
]]></query>
