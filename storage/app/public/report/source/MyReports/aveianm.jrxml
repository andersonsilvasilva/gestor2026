	<style name="Estilo_cores_alternadas" mode="Opaque" backcolor="#FFFFFF">
		<conditionalStyle backcolor="#CCFFFF">
			<conditionExpression><![CDATA[$V{REPORT_COUNT} % 2==0]]></conditionExpression>
		</conditionalStyle>
	</style>
	<parameter name="id_colaborador" class="java.lang.String"/>
	<parameter name="dta_inicio" class="java.lang.String"/>
	<parameter name="dta_fim" class="java.lang.String"/>
	<query language="SQL"><![CDATA[SELECT detalhe_colaborador.cns AS cns_colaborador,
	detalhe_colaborador.telefone AS fone_colaborador,
	detalhe_colaborador.cbo AS cbo_colaborador,
	colaborador.name,
	colaborador.email,
	procedimento.name AS procedimento_nome,
	eventos.start,
	eventos.status,
	eventos.descricao,
	clientes.nome,
	clientes.cns AS cns_cliente,
	clientes.sexo,
	clientes.data_nascimento,
	clientes.bairro,
	clientes.cidade,
	clientes.uf
FROM clients AS clientes
	INNER JOIN eventos AS eventos ON 
	eventos.client_id = clientes.id 
	INNER JOIN procediments AS procedimento ON 
	 procedimento.id = eventos.procediments_id 
	INNER JOIN users AS colaborador ON 
	 colaborador.id = eventos.user_id 
	INNER JOIN user_details AS detalhe_colaborador ON 
	 detalhe_colaborador.user_id = colaborador.id
	WHERE    (procedimento.tipo_relate='ave')  
			AND  (eventos.user_id= $P{id_colaborador} ) 
		 	AND (eventos.start  BETWEEN  CAST($P{dta_inicio} AS DATE) 
		 	AND  CAST($P{dta_fim} AS DATE)
		 	)
	ORDER BY  eventos.start ASC]]></query>
