	<parameter name="idcliente" class="java.lang.Integer">
		<description><![CDATA[ID do Cliente]]></description>
	</parameter>
	<query language="SQL"><![CDATA[SELECT detalhe_colaborador.cns AS cns_colaborador,
	detalhe_colaborador.telefone AS fone_colaborador,
	detalhe_colaborador.cbo AS cbo_colaborador,
	colaborador.name,
	colaborador.email,
	procedimento.name AS procedimento_nome,
	eventos.start,
	eventos.status,
	eventos.descricao,
	clients.nome,
	clients.cns AS cns_cliente,
	clients.cor,
	clients.nacionalidade,
	clients.cpf AS cpf_cliente,
	clients.etnia,
	clients.sexo,
	clients.data_nascimento,
	clients.email AS email_cliente,
	clients.telefone AS cel_cliente,
	clients.logradouro,
	clients.endereco,
	clients.numero,
	clients.estado_civil,
	clients.bairro,
	clients.cidade,
	clients.cep,
	clients.uf,
	clients.tipo_sangue,
	clients.ativ_laboral
FROM u361963046_dburpics.clients AS clients
	INNER JOIN u361963046_dburpics.eventos AS eventos ON 
	 eventos.client_id = clients.id 
	INNER JOIN u361963046_dburpics.procediments AS procedimento ON 
	 procedimento.id = eventos.procediments_id 
	INNER JOIN u361963046_dburpics.users AS colaborador ON 
	 colaborador.id = eventos.user_id 
	INNER JOIN u361963046_dburpics.user_details AS detalhe_colaborador ON 
	 detalhe_colaborador.user_id = colaborador.id 
WHERE 
	 clients.id  = $P{idcliente} 
ORDER BY eventos.start ASC]]></query>
